#!/bin/bash
# Find the app holding macOS Secure Input (which blocks alt+letter AeroSpace
# shortcuts) and offer to quit it. Bound to alt-shift-enter in .aerospace.toml.

notify() {
  osascript -e "display notification \"$1\" with title \"Secure Input\"" >/dev/null 2>&1
}

secure_pid() {
  ioreg -l -w 0 | grep -o '"kCGSSessionSecureInputPID"=[0-9]*' | head -n1 | cut -d= -f2
}

pid=$(secure_pid)
if [[ -z "$pid" ]]; then
  notify "Secure Input is off. Nothing to quit."
  exit 0
fi

if ! ps -p "$pid" >/dev/null 2>&1; then
  notify "Secure Input is held by a process that no longer exists. Lock and unlock your screen (ctrl-cmd-Q) to release it."
  exit 1
fi

path=$(ps -p "$pid" -o comm=)
name=$(basename "$path")
if [[ "$path" == *.app/* ]]; then
  app=$(basename "${path%%.app/*}")
else
  app="$name"
fi

# Never quit system processes: quitting loginwindow logs you out.
case "$name" in
  loginwindow|WindowServer|launchd|kernel_task|SecurityAgent)
    notify "Secure Input is held by $name (a system process). Lock and unlock your screen (ctrl-cmd-Q) to release it."
    exit 1
    ;;
esac
if [[ "$(ps -p "$pid" -o user= | tr -d ' ')" != "$(id -un)" ]]; then
  notify "Secure Input is held by $name, which isn't your process. Lock and unlock your screen to release it."
  exit 1
fi

answer=$(osascript -e "button returned of (display dialog \"$app is holding Secure Input, which blocks your AeroSpace shortcuts.\n\nQuit $app?\" buttons {\"Cancel\", \"Quit\"} default button \"Quit\" with title \"Secure Input\" with icon caution)" 2>/dev/null)
[[ "$answer" == "Quit" ]] || exit 0

# Normal quit (SIGTERM), not a force kill, so apps like Chrome shut down cleanly.
kill -TERM "$pid"
for _ in {1..40}; do
  ps -p "$pid" >/dev/null 2>&1 || break
  sleep 0.25
done

if ps -p "$pid" >/dev/null 2>&1; then
  notify "$app didn't quit. It may be waiting on a dialog; quit it manually."
elif [[ -n "$(secure_pid)" ]]; then
  notify "Quit $app, but another app is still holding Secure Input. Press alt-shift-enter again."
else
  notify "Quit $app. Secure Input is off and your shortcuts should work again."
fi
